<UserControl x:Class="PdfEditor.App.PdfEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" AllowDrop="True" FocusVisualStyle="{x:Null}" Background="{DynamicResource BgBrush}">
    <DockPanel>
        <!-- A focus scope, like a toolbar: using it does not take typing away from the page. -->
        <Border x:Name="Tools" DockPanel.Dock="Top" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="8,7,8,2" FocusManager.IsFocusScope="True">
            <Border.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,4,0" />
                </Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Margin" Value="0,0,4,0" />
                </Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Margin" Value="0,0,4,0" />
                </Style>
                <Style x:Key="Group" TargetType="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal" />
                    <Setter Property="Margin" Value="0,0,14,5" />
                </Style>
            </Border.Resources>
            <WrapPanel>
            <StackPanel Style="{StaticResource Group}">
                <Button Content="New" Click="New_Click" ToolTip="New document" />
                <Button Content="Open" Click="Open_Click" ToolTip="Open a PDF (Ctrl+O)" />
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click" ToolTip="Save (Ctrl+S)" />
                <Button Content="Save As" Click="SaveAs_Click" ToolTip="Save under a new name (Ctrl+Shift+S)" />
                <Border Style="{DynamicResource ToolSeparator}" />
                <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" />
                <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" />
            </StackPanel>
            <StackPanel Style="{StaticResource Group}">
                <Button Content="Add page" Click="AddPage_Click" ToolTip="Add a blank page after this one. Asks for its size; hold Shift to be asked again once a size is kept" />
                <Button Content="Page break" Click="PageBreak_Click" ToolTip="Break this page in two. With an item selected, it and everything below it move to a new page; with nothing selected, a line follows the mouse and a click breaks the page there" />
                <Button Content="Insert file" Click="InsertFile_Click" ToolTip="Insert the pages of a PDF, or an RTF document laid out as pages, after this page" />
                <Button x:Name="DeletePageButton" Content="Delete page" Click="DeletePage_Click" ToolTip="Delete this page" />
                <Button Content="Rotate" Click="Rotate_Click" ToolTip="Rotate this page a quarter turn clockwise" />
                <Button x:Name="PageUpButton" Content="Move up" Click="MovePageUp_Click" ToolTip="Move this page earlier" />
                <Button x:Name="PageDownButton" Content="Move down" Click="MovePageDown_Click" ToolTip="Move this page later" />
                <Button Content="Print as tiles" Click="PrintAsTiles_Click" ToolTip="Save this page spread over several sheets of paper, to print and join into a poster. The document is not changed" />
            </StackPanel>
            <StackPanel Style="{StaticResource Group}">
                <Button Content="-" Width="26" Padding="0" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)" />
                <TextBlock x:Name="ZoomText" Width="44" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Content="+" Width="26" Padding="0" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)" />
                <Button Content="Fit width" Click="FitWidth_Click" />
            </StackPanel>
            <StackPanel Style="{StaticResource Group}">
                <RadioButton x:Name="SelectTool" Style="{DynamicResource ToolRadio}" GroupName="Tool" Content="Select" Tag="Select" IsChecked="True" Checked="Tool_Checked"
                             ToolTip="Click to select, drag to move, double-click text to edit it, Delete to remove" />
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Content="Text" Tag="Text" Checked="Tool_Checked" ToolTip="Click on the page to type new text" />
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Content="Highlight" Tag="Highlight" Checked="Tool_Checked" ToolTip="Drag across text to highlight it" />
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Content="Comment" Tag="Comment" Checked="Tool_Checked" ToolTip="Click on the page to leave a comment" />
                <Button Content="Image" Click="AddImage_Click" ToolTip="Place an image on this page" />
                <Border Style="{DynamicResource ToolSeparator}" />
                <Button Content="Find &amp; replace" Click="FindReplace_Click" ToolTip="Replace text throughout the document; changed paragraphs re-flow (Ctrl+H)" />
            </StackPanel>
            <StackPanel Style="{StaticResource Group}">
                <TextBlock Text="Text:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="FontBox" Width="80" SelectedIndex="0" ToolTip="Font for new text">
                    <ComboBoxItem Content="Sans" />
                    <ComboBoxItem Content="Serif" />
                    <ComboBoxItem Content="Mono" />
                </ComboBox>
                <ComboBox x:Name="SizeBox" Width="56" IsEditable="True" Text="12" ToolTip="Font size in points">
                    <ComboBoxItem Content="8" />
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="12" />
                    <ComboBoxItem Content="14" />
                    <ComboBoxItem Content="18" />
                    <ComboBoxItem Content="24" />
                    <ComboBoxItem Content="36" />
                    <ComboBoxItem Content="48" />
                </ComboBox>
                <ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Width="28" Padding="0" ToolTip="Bold" />
                <ToggleButton x:Name="ItalicButton" Content="I" FontStyle="Italic" Width="28" Padding="0" ToolTip="Italic" />
                <ComboBox x:Name="ColorBox" Width="90" ToolTip="Text colour" />
                <Border Style="{DynamicResource ToolSeparator}" />
                <TextBlock Text="Highlight:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="HighlightBox" Width="90" ToolTip="Highlight colour" />
            </StackPanel>
            <StackPanel Style="{StaticResource Group}">
                <TextBlock Text="Paragraph:" VerticalAlignment="Center" Margin="4,0" />
                <Button Content="Left" Tag="Left" Click="Align_Click" ToolTip="Align the selected paragraph left" />
                <Button Content="Centre" Tag="Center" Click="Align_Click" ToolTip="Centre the selected paragraph" />
                <Button Content="Right" Tag="Right" Click="Align_Click" ToolTip="Align the selected paragraph right" />
                <Button Content="Justify" Tag="Justify" Click="Align_Click" ToolTip="Justify the selected paragraph" />
            </StackPanel>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="PageText" DockPanel.Dock="Left" />
                <Border DockPanel.Dock="Left" Width="1" Margin="10,1" Background="{DynamicResource LineHoverBrush}" />
                <TextBlock x:Name="HintText" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" MinWidth="90" MaxWidth="600" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource LineBrush}" ToolTip="Drag to resize the page list" />

            <ListBox x:Name="Thumbs" Grid.Column="0" SelectionChanged="Thumbs_SelectionChanged" AllowDrop="True"
                     PreviewMouseLeftButtonDown="Thumbs_PreviewMouseLeftButtonDown" PreviewMouseMove="Thumbs_PreviewMouseMove"
                     DragOver="Thumbs_DragOver" DragLeave="Thumbs_DragLeave" Drop="Thumbs_Drop" SizeChanged="Thumbs_SizeChanged"
                     ToolTip="Drag a page to change its place"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <Border BorderBrush="#888" BorderThickness="1" Background="White" HorizontalAlignment="Center">
                                <Image Source="{Binding Thumbnail}" Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}" />
                            </Border>
                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Shows where a dragged page will land. -->
            <Rectangle x:Name="DropLine" Grid.Column="0" Height="3" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Top" Margin="6,0"
                       IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="5" />

            <ScrollViewer x:Name="PageScroll" Grid.Column="2" Background="{DynamicResource BgBrush}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="PageScroll_PreviewMouseWheel">
                <Border Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White"
                        BorderBrush="{DynamicResource LineHoverBrush}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="PageImage" Stretch="Fill" />
                        <Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True"
                                MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp"
                                MouseRightButtonDown="Overlay_RightClick" MouseLeave="Overlay_MouseLeave" />
                    </Grid>
                </Border>
            </ScrollViewer>

            <DockPanel Grid.Column="3">
                <Button x:Name="NotesToggle" DockPanel.Dock="Left" Width="18" Padding="0" Content="&#x00BB;" Click="NotesToggle_Click"
                        ToolTip="Hide the comments panel" />
                <DockPanel x:Name="NotesPanel" Width="250" Background="{DynamicResource BarBrush}">
                <TextBlock DockPanel.Dock="Top" Text="Comments and highlights on this page" FontWeight="SemiBold" Margin="8,6" TextWrapping="Wrap" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,6">
                    <Button x:Name="EditNoteButton" Content="Edit text" Padding="8,2" Margin="0,0,6,0" Click="EditNote_Click" />
                    <Button x:Name="DeleteNoteButton" Content="Delete" Padding="8,2" Click="DeleteNote_Click" />
                </StackPanel>
                <ListBox x:Name="Notes" Background="Transparent" SelectionChanged="Notes_SelectionChanged" MouseDoubleClick="Notes_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
