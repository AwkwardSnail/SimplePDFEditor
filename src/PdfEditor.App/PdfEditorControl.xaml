<UserControl x:Class="PdfEditor.App.PdfEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" AllowDrop="True" FocusVisualStyle="{x:Null}">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0">
                <Button Content="New" Click="New_Click" ToolTip="New document" />
                <Button Content="Open" Click="Open_Click" ToolTip="Open a PDF (Ctrl+O)" />
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click" ToolTip="Save (Ctrl+S)" />
                <Button Content="Save As" Click="SaveAs_Click" ToolTip="Save under a new name (Ctrl+Shift+S)" />
                <Separator />
                <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" />
                <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" />
            </ToolBar>
            <ToolBar Band="0" BandIndex="1">
                <Button Content="Add page" Click="AddPage_Click" ToolTip="Add a blank page after this one" />
                <Button Content="Insert PDF" Click="InsertPdf_Click" ToolTip="Insert the pages of another PDF after this page" />
                <Button x:Name="DeletePageButton" Content="Delete page" Click="DeletePage_Click" ToolTip="Delete this page" />
                <Button Content="Rotate" Click="Rotate_Click" ToolTip="Rotate this page a quarter turn clockwise" />
                <Button x:Name="PageUpButton" Content="Move up" Click="MovePageUp_Click" ToolTip="Move this page earlier" />
                <Button x:Name="PageDownButton" Content="Move down" Click="MovePageDown_Click" ToolTip="Move this page later" />
            </ToolBar>
            <ToolBar Band="0" BandIndex="2">
                <Button Content="-" Width="24" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)" />
                <TextBlock x:Name="ZoomText" Width="44" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Content="+" Width="24" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)" />
                <Button Content="Fit width" Click="FitWidth_Click" />
            </ToolBar>
            <ToolBar Band="1" BandIndex="0">
                <RadioButton x:Name="SelectTool" GroupName="Tool" Content="Select" Tag="Select" IsChecked="True" Checked="Tool_Checked"
                             ToolTip="Click to select, drag to move, double-click text to edit it, Delete to remove" />
                <RadioButton GroupName="Tool" Content="Text" Tag="Text" Checked="Tool_Checked" ToolTip="Click on the page to type new text" />
                <RadioButton GroupName="Tool" Content="Highlight" Tag="Highlight" Checked="Tool_Checked" ToolTip="Drag across text to highlight it" />
                <RadioButton GroupName="Tool" Content="Comment" Tag="Comment" Checked="Tool_Checked" ToolTip="Click on the page to leave a comment" />
                <Button Content="Image" Click="AddImage_Click" ToolTip="Place an image on this page" />
            </ToolBar>
            <ToolBar Band="1" BandIndex="1">
                <TextBlock Text="Text:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="FontBox" Width="80" SelectedIndex="0" ToolTip="Font for new text">
                    <ComboBoxItem Content="Sans" />
                    <ComboBoxItem Content="Serif" />
                    <ComboBoxItem Content="Mono" />
                </ComboBox>
                <ComboBox x:Name="SizeBox" Width="56" IsEditable="True" Text="12" ToolTip="Font size in points">
                    <ComboBoxItem Content="8" />
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="12" />
                    <ComboBoxItem Content="14" />
                    <ComboBoxItem Content="18" />
                    <ComboBoxItem Content="24" />
                    <ComboBoxItem Content="36" />
                    <ComboBoxItem Content="48" />
                </ComboBox>
                <ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Width="24" ToolTip="Bold" />
                <ToggleButton x:Name="ItalicButton" Content="I" FontStyle="Italic" Width="24" ToolTip="Italic" />
                <ComboBox x:Name="ColorBox" Width="90" ToolTip="Text colour" />
                <Separator />
                <TextBlock Text="Highlight:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="HighlightBox" Width="90" ToolTip="Highlight colour" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="PageText" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="HintText" /></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Thumbs" Grid.Column="0" SelectionChanged="Thumbs_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <Border BorderBrush="#888" BorderThickness="1" Background="White" HorizontalAlignment="Center">
                                <Image Source="{Binding Thumbnail}" Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}" />
                            </Border>
                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer x:Name="PageScroll" Grid.Column="1" Background="#FF6B6F76"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="PageScroll_PreviewMouseWheel">
                <Border Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White"
                        BorderBrush="#444" BorderThickness="1">
                    <Grid>
                        <Image x:Name="PageImage" Stretch="Fill" />
                        <Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True"
                                MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp" />
                    </Grid>
                </Border>
            </ScrollViewer>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Comments and highlights on this page" FontWeight="SemiBold" Margin="8,6" TextWrapping="Wrap" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,6">
                    <Button x:Name="EditNoteButton" Content="Edit text" Padding="8,2" Margin="0,0,6,0" Click="EditNote_Click" />
                    <Button x:Name="DeleteNoteButton" Content="Delete" Padding="8,2" Click="DeleteNote_Click" />
                </StackPanel>
                <ListBox x:Name="Notes" SelectionChanged="Notes_SelectionChanged" MouseDoubleClick="Notes_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
