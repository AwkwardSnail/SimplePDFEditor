<UserControl x:Class="PdfEditor.App.PdfEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" AllowDrop="True" FocusVisualStyle="{x:Null}" Background="{DynamicResource BgBrush}">
    <DockPanel>
        <!-- A focus scope, like a toolbar: using it does not take typing away from the page. -->
        <Border x:Name="Tools" DockPanel.Dock="Top" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="8,7,8,2" FocusManager.IsFocusScope="True">
            <Border.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,4,0" />
                </Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Margin" Value="0,0,4,0" />
                </Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Margin" Value="0,0,4,0" />
                </Style>
                <!-- A picture beside each word: Windows' own symbol font, and small drawn shapes for the drawing tools. -->
                <Style x:Key="Icon" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="ShapeIcon" TargetType="Path">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="Height" Value="16" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="StrokeThickness" Value="1.5" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
                </Style>
                <Style x:Key="Group" TargetType="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal" />
                    <Setter Property="Margin" Value="0,0,14,5" />
                </Style>
            </Border.Resources>
            <StackPanel>
            <!-- Row 1: the file, and its pages. -->
            <WrapPanel>
            <StackPanel Style="{StaticResource Group}">
                <Button Click="New_Click" ToolTip="New document (Ctrl+N)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" /><TextBlock Text="New" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Click="Open_Click" ToolTip="Open a PDF (Ctrl+O)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /><TextBlock Text="Open" VerticalAlignment="Center" /></StackPanel></Button>
                <Button x:Name="SaveButton" Click="Save_Click" ToolTip="Save (Ctrl+S)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /><TextBlock Text="Save" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Click="SaveAs_Click" ToolTip="Save under a new name (Ctrl+Shift+S)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE792;" /><TextBlock Text="Save As" VerticalAlignment="Center" /></StackPanel></Button>
                <Border Style="{DynamicResource ToolSeparator}" />
                <Button x:Name="UndoButton" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /><TextBlock Text="Undo" VerticalAlignment="Center" /></StackPanel></Button>
                <Button x:Name="RedoButton" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /><TextBlock Text="Redo" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <StackPanel Style="{StaticResource Group}">
                <TextBlock Text="Pages:" VerticalAlignment="Center" Margin="4,0" />
                <Button Click="AddPage_Click" ToolTip="Add page: a blank page after this one. Asks for its size; hold Shift to be asked again once a size is kept"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /><TextBlock Text="Add" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Click="PageBreak_Click" ToolTip="Page break: break this page in two. With an item selected, it and everything below it move to a new page; with nothing selected, a line follows the mouse and a click breaks the page there"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" /><TextBlock Text="Break" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Click="InsertFile_Click" ToolTip="Insert file: the pages of a PDF, or an RTF document laid out as pages, after this page"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" /><TextBlock Text="Insert" VerticalAlignment="Center" /></StackPanel></Button>
                <Button x:Name="DeletePageButton" Click="DeletePage_Click" ToolTip="Delete this page"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" /><TextBlock Text="Delete" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Click="Rotate_Click" ToolTip="Rotate this page a quarter turn clockwise"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" /><TextBlock Text="Rotate" VerticalAlignment="Center" /></StackPanel></Button>
                <Button x:Name="PageUpButton" Click="MovePageUp_Click" ToolTip="Move this page earlier"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" /><TextBlock Text="Up" VerticalAlignment="Center" /></StackPanel></Button>
                <Button x:Name="PageDownButton" Click="MovePageDown_Click" ToolTip="Move this page later"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" /><TextBlock Text="Down" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Click="PrintAsTiles_Click" ToolTip="Print as tiles: save this page spread over several sheets of paper, to print and join into a poster. The document is not changed"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80A;" /><TextBlock Text="Tiles" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            </WrapPanel>

            <!-- Row 2: the tools, with the zoom in the middle (see CentreZoom), close to the page. -->
            <WrapPanel x:Name="ToolsRow" SizeChanged="ToolsRow_SizeChanged">
            <StackPanel x:Name="ToolsGroup" Style="{StaticResource Group}">
                <RadioButton x:Name="SelectTool" Style="{DynamicResource ToolRadio}" GroupName="Tool" Tag="Select" IsChecked="True" Checked="Tool_Checked"
                             ToolTip="Click to select, drag to move, double-click text to edit it, Delete to remove"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B0;" /><TextBlock Text="Select" VerticalAlignment="Center" /></StackPanel></RadioButton>
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Tag="Text" Checked="Tool_Checked" ToolTip="Click on the page to type new text"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8D2;" /><TextBlock Text="Text" VerticalAlignment="Center" /></StackPanel></RadioButton>
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Tag="Highlight" Checked="Tool_Checked" ToolTip="Drag across text to highlight it"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7E6;" /><TextBlock Text="Highlight" VerticalAlignment="Center" /></StackPanel></RadioButton>
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Tag="Comment" Checked="Tool_Checked" ToolTip="Click on the page to leave a comment"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE90A;" /><TextBlock Text="Comment" VerticalAlignment="Center" /></StackPanel></RadioButton>
                <Button Click="AddImage_Click" ToolTip="Place an image on this page"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" /><TextBlock Text="Image" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Click="Watermark_Click" ToolTip="Write a word such as DRAFT large and see-through across this page, or every page"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8D3;" /><TextBlock Text="Watermark" VerticalAlignment="Center" /></StackPanel></Button>
                <Border Style="{DynamicResource ToolSeparator}" />
                <Button Click="FindReplace_Click" ToolTip="Find and replace text throughout the document; changed paragraphs re-flow (Ctrl+H)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" /><TextBlock Text="Find" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <StackPanel x:Name="ZoomGroup" Style="{StaticResource Group}">
                <Button Width="34" Padding="0" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)"><TextBlock Style="{StaticResource Icon}" Margin="0" Text="&#xE71F;" /></Button>
                <TextBlock x:Name="ZoomText" Width="52" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Width="34" Padding="0" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)"><TextBlock Style="{StaticResource Icon}" Margin="0" Text="&#xE8A3;" /></Button>
                <Button Click="FitWidth_Click" ToolTip="Make the page as wide as the room for it"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" /><TextBlock Text="Fit width" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <StackPanel x:Name="DrawGroup" Style="{StaticResource Group}">
                <TextBlock Text="Draw:" VerticalAlignment="Center" Margin="4,0" />
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Tag="Line" Checked="Tool_Checked" ToolTip="Drag to draw a straight line. Shift keeps it level, upright or at 45 degrees"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ShapeIcon}" Data="M2,14 L14,2" /><TextBlock Text="Line" VerticalAlignment="Center" /></StackPanel></RadioButton>
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Tag="Arrow" Checked="Tool_Checked" ToolTip="Drag to draw an arrow; it points where the drag ends"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ShapeIcon}" Data="M2,14 L14,2 M7,2 L14,2 L14,9" /><TextBlock Text="Arrow" VerticalAlignment="Center" /></StackPanel></RadioButton>
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Tag="Box" Checked="Tool_Checked" ToolTip="Drag to draw a box. Shift makes it square"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ShapeIcon}" Data="M2,3 H14 V13 H2 Z" /><TextBlock Text="Box" VerticalAlignment="Center" /></StackPanel></RadioButton>
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Tag="Circle" Checked="Tool_Checked" ToolTip="Drag to draw a circle or oval. Shift keeps it round"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ShapeIcon}" Data="M8,2 A6,6 0 1 1 7.99,2 Z" /><TextBlock Text="Circle" VerticalAlignment="Center" /></StackPanel></RadioButton>
                <RadioButton Style="{DynamicResource ToolRadio}" GroupName="Tool" Tag="Spline" Checked="Tool_Checked" ToolTip="Click point after point to draw a smooth curve through them; double-click or Enter finishes, Esc cancels"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ShapeIcon}" Data="M2,12 C5,0 9,16 14,4" /><TextBlock Text="Spline" VerticalAlignment="Center" /></StackPanel></RadioButton>
            </StackPanel>
            </WrapPanel>

            <!-- Row 3: how new text, shapes and highlights look, and the selected paragraph's alignment. -->
            <WrapPanel>
            <StackPanel Style="{StaticResource Group}">
                <TextBlock Text="Text:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="FontBox" Width="88" SelectedIndex="0" ToolTip="Font for new text">
                    <ComboBoxItem Content="Sans" />
                    <ComboBoxItem Content="Serif" />
                    <ComboBoxItem Content="Mono" />
                </ComboBox>
                <ComboBox x:Name="SizeBox" Width="62" IsEditable="True" Text="12" ToolTip="Font size in points">
                    <ComboBoxItem Content="8" />
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="12" />
                    <ComboBoxItem Content="14" />
                    <ComboBoxItem Content="18" />
                    <ComboBoxItem Content="24" />
                    <ComboBoxItem Content="36" />
                    <ComboBoxItem Content="48" />
                </ComboBox>
                <ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Width="32" Padding="0" ToolTip="Bold" />
                <ToggleButton x:Name="ItalicButton" Content="I" FontStyle="Italic" Width="32" Padding="0" ToolTip="Italic" />
                <ComboBox x:Name="ColorBox" Width="104" ToolTip="Text colour" />
            </StackPanel>
            <StackPanel Style="{StaticResource Group}">
                <TextBlock Text="Paragraph:" VerticalAlignment="Center" Margin="4,0" />
                <Button Tag="Left" Click="Align_Click" ToolTip="Align the selected paragraph left"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E4;" /><TextBlock Text="Left" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Tag="Center" Click="Align_Click" ToolTip="Centre the selected paragraph"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E3;" /><TextBlock Text="Centre" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Tag="Right" Click="Align_Click" ToolTip="Align the selected paragraph right"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E2;" /><TextBlock Text="Right" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Tag="Justify" Click="Align_Click" ToolTip="Justify the selected paragraph"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" /><TextBlock Text="Justify" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <StackPanel Style="{StaticResource Group}">
                <TextBlock Text="Shapes:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="LineColourBox" Width="104" ToolTip="Line colour for new shapes" />
                <ComboBox x:Name="LineWidthBox" Width="76" SelectedIndex="1" ToolTip="Line thickness for new shapes, in points">
                    <ComboBoxItem Content="1 pt" Tag="1" />
                    <ComboBoxItem Content="2 pt" Tag="2" />
                    <ComboBoxItem Content="3 pt" Tag="3" />
                    <ComboBoxItem Content="5 pt" Tag="5" />
                    <ComboBoxItem Content="8 pt" Tag="8" />
                </ComboBox>
                <TextBlock Text="Fill:" VerticalAlignment="Center" Margin="6,0,4,0" />
                <ComboBox x:Name="FillBox" Width="104" ToolTip="Fill for new boxes, circles and splines. None leaves them see-through" />
            </StackPanel>
            <StackPanel Style="{StaticResource Group}">
                <TextBlock Text="Highlight:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="HighlightBox" Width="104" ToolTip="Highlight colour" />
            </StackPanel>
            </WrapPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="PageText" DockPanel.Dock="Left" />
                <Border DockPanel.Dock="Left" Width="1" Margin="10,1" Background="{DynamicResource LineHoverBrush}" />
                <TextBlock x:Name="HintText" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" MinWidth="90" MaxWidth="600" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource LineBrush}" ToolTip="Drag to resize the page list" />

            <ListBox x:Name="Thumbs" Grid.Column="0" SelectionChanged="Thumbs_SelectionChanged" AllowDrop="True"
                     PreviewMouseLeftButtonDown="Thumbs_PreviewMouseLeftButtonDown" PreviewMouseRightButtonUp="Thumbs_RightClick" PreviewMouseMove="Thumbs_PreviewMouseMove"
                     DragOver="Thumbs_DragOver" DragLeave="Thumbs_DragLeave" Drop="Thumbs_Drop" SizeChanged="Thumbs_SizeChanged"
                     ToolTip="Drag a page to change its place. Right-click for more"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <Border BorderBrush="#888" BorderThickness="1" Background="White" HorizontalAlignment="Center">
                                <Image Source="{Binding Thumbnail}" Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}" />
                            </Border>
                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Shows where a dragged page will land. -->
            <Rectangle x:Name="DropLine" Grid.Column="0" Height="3" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Top" Margin="6,0"
                       IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="5" />

            <ScrollViewer x:Name="PageScroll" Grid.Column="2" Background="{DynamicResource BgBrush}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="PageScroll_PreviewMouseWheel">
                <Border Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White"
                        BorderBrush="{DynamicResource LineHoverBrush}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="PageImage" Stretch="Fill" />
                        <Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True"
                                MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp"
                                MouseRightButtonDown="Overlay_RightClick" MouseLeave="Overlay_MouseLeave" />
                    </Grid>
                </Border>
            </ScrollViewer>

            <DockPanel Grid.Column="3">
                <Button x:Name="NotesToggle" DockPanel.Dock="Left" Width="18" Padding="0" Content="&#x00BB;" Click="NotesToggle_Click"
                        ToolTip="Hide the comments panel" />
                <DockPanel x:Name="NotesPanel" Width="250" Background="{DynamicResource BarBrush}">
                <TextBlock DockPanel.Dock="Top" Text="Comments and highlights on this page" FontWeight="SemiBold" Margin="8,6" TextWrapping="Wrap" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,6">
                    <Button x:Name="EditNoteButton" Content="Edit text" Padding="8,2" Margin="0,0,6,0" Click="EditNote_Click" />
                    <Button x:Name="DeleteNoteButton" Content="Delete" Padding="8,2" Click="DeleteNote_Click" />
                </StackPanel>
                <ListBox x:Name="Notes" Background="Transparent" SelectionChanged="Notes_SelectionChanged" MouseDoubleClick="Notes_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
