<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfEditor.App</RootNamespace>
    <AssemblyName>SimplePDFEditor</AssemblyName>
    <!-- The aWkward sn@ail icon, made by packaging\generate-icons.ps1. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Runs as the user, and is sharp at each screen's own scaling (see app.manifest). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lets the project compile on non-Windows build machines; it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Atkinson Hyperlegible Next, SIL OFL 1.1 (Fonts\OFL.txt). Built into the app so it looks the same everywhere. -->
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The terms of what the app is built on; goes out with every copy of the app. -->
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfEditor.Core\PdfEditor.Core.csproj" />
  </ItemGroup>

</Project>
