<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the PDF editor.

  NOT YET A STORE IDENTITY. The Identity Name below is a placeholder for testing on this
  PC (pack.ps1 -Install). Before a Store submission, reserve the product in Partner Center
  and copy Identity Name from Product management > Product identity exactly, including the
  "Akward" spelling of the prefix; then set the final display name here too.
  Identity Publisher and PublisherDisplayName are the Awkward Snail ones used by the other apps.
  pack.ps1 sets Identity Version from its -Version parameter.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="AkwardSnail.PdfEditorDev"
    Publisher="CN=A55585C2-FE40-4ED1-9B77-46466AE9C532"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PDF Editor</DisplayName>
    <PublisherDisplayName>aWkward Snail</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="PdfEditor" Executable="PdfEditor.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PDF Editor"
        Description="Edit PDFs: text, pages, pictures, highlights and comments."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0D0F0C" />
      </uap:VisualElements>
      <Extensions>
        <!-- Offers the editor under "Open with" for PDF and RTF files. It does not take over as the default app. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdfeditordocument">
            <uap:DisplayName>Document</uap:DisplayName>
            <uap:Logo>Assets\StoreLogo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
              <uap:FileType>.rtf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Needed by every classic desktop (WPF) app in an MSIX package. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
